    "entrypoint": "bash -lc 'set -eu\nif [ -s /script/requirements.txt ]; then python3 -m pip install --quiet --no-cache-dir -r /script/requirements.txt || python3 -m pip install --quiet --no-cache-dir --user -r /script/requirements.txt; fi\nPATH=\"$(python3 -m site --user-base)/bin:$PATH\"; export PATH\ncd /data\npython3 /script/_tau_runner.py --notebook analysis.ipynb\n'",
