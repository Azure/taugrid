# Stage 1: Build with MSFT Go (Debian-based) for FIPS compliance
FROM mcr.microsoft.com/oss/go/microsoft/golang:1.26.8-1 AS builder
# TODO: change default to v0.2.0 once adx-mon team tags a release
ARG ADX_MON_VERSION=main

# Install build deps: libsystemd-dev for journald CGO bindings, git for clone
RUN apt-get update && apt-get install -y --no-install-recommends \
    git libsystemd-dev gcc && rm -rf /var/lib/apt/lists/*

# Clone adx-mon at pinned version tag (must be a named ref — commit SHAs not supported)
RUN git clone --depth 1 --branch ${ADX_MON_VERSION} \
    https://github.com/Azure/adx-mon.git /code
WORKDIR /code

# Build collector with FIPS crypto
# GOEXPERIMENT=systemcrypto: routes TLS/crypto through system OpenSSL (FIPS 140-2/3)
# CGO_ENABLED=1: required for libsystemd (sdjournal/dlopen) and systemcrypto
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 GOEXPERIMENT=systemcrypto \
    go build -buildvcs=false \
    -ldflags="-X 'github.com/Azure/adx-mon/pkg/version.Version=${ADX_MON_VERSION}' \
              -X 'github.com/Azure/adx-mon/pkg/version.GitCommit=$(git rev-parse HEAD)' \
              -X 'github.com/Azure/adx-mon/pkg/version.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)'" \
    -o ./bin/collector ./cmd/collector

# Stage 2: systemd-libs source (Azure Linux) for runtime libsystemd.so
# The distroless final image has no package manager; copy .so files from here.
FROM mcr.microsoft.com/azurelinux/base/core:3.0 AS systemd-source
RUN tdnf install -y systemd-libs xz-libs zstd-libs lz4 libcap-ng libgcrypt libgpg-error && tdnf clean all

# Stage 3: Distroless runtime image
FROM mcr.microsoft.com/azurelinux/distroless/base:3.0

LABEL org.opencontainers.image.source=https://github.com/Azure/adx-mon
LABEL org.opencontainers.image.description="AdxMon Collector — DaemonSet metrics/logs agent for Azure Data Explorer"
LABEL org.opencontainers.image.licenses=MIT

# Copy collector binary
COPY --from=builder /code/bin/collector /collector

# Copy libsystemd and its full transitive dependency closure.
# collector uses dlopen("libsystemd.so.0", RTLD_LAZY) at runtime via go-systemd/sdjournal.
# Without these .so files present, dlopen fails silently and journal collection is disabled.
# Derived from upstream Azure/adx-mon Dockerfile.collector (LD_DEBUG=libs analysis):
# libsystemd.so.0 depends on: liblzma, libzstd, liblz4, libcap, libgcrypt, libgpg-error
COPY --from=systemd-source \
    /usr/lib/libsystemd.so.0 \
    /usr/lib/liblzma.so.5 \
    /usr/lib/libzstd.so.1 \
    /usr/lib/liblz4.so.1 \
    /usr/lib/libcap.so.2 \
    /usr/lib/libgcrypt.so.20 \
    /usr/lib/libgpg-error.so.0 \
    /usr/lib/

ENTRYPOINT ["/collector"]
