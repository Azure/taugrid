FROM mcr.microsoft.com/oss/go/microsoft/golang:1.26.9-1 AS builder
ARG ADX_MON_VERSION=main

RUN apt-get update && apt-get install -y --no-install-recommends \
    git gcc && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch ${ADX_MON_VERSION} \
    https://github.com/Azure/adx-mon.git /code
WORKDIR /code

RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 GOEXPERIMENT=systemcrypto \
    go build -buildvcs=false \
    -ldflags="-X 'github.com/Azure/adx-mon/pkg/version.Version=${ADX_MON_VERSION}' \
              -X 'github.com/Azure/adx-mon/pkg/version.GitCommit=$(git rev-parse HEAD)' \
              -X 'github.com/Azure/adx-mon/pkg/version.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)'" \
    -o ./bin/ingestor ./cmd/ingestor

FROM mcr.microsoft.com/azurelinux/distroless/base:3.0

LABEL org.opencontainers.image.source=https://github.com/Azure/adx-mon
LABEL org.opencontainers.image.description="AdxMon Ingestor — StatefulSet batch writer to Azure Data Explorer"
LABEL org.opencontainers.image.licenses=MIT

COPY --from=builder /code/bin/ingestor /ingestor
ENTRYPOINT ["/ingestor"]
