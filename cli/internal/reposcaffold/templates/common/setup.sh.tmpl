set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required. Install it from https://docs.astral.sh/uv/ and rerun this script." >&2
  exit 2
fi

uv sync --extra dev
uv run python -m {{.Package}}.smoke

if command -v tau >/dev/null 2>&1; then
  tau version || true
else
  cat >&2 <<'EOF'
Tau CLI was not found on PATH.
Install the Tau CLI for your platform before validating or running a target.
EOF
fi

echo "Local Python setup complete."
cat <<'EOF'
Next steps:
  source ./.env
  docker build -f images/train.Dockerfile -t "$IMAGE" .
  docker push "$IMAGE"
  ./scripts/configure.sh --image "$IMAGE"
  tau run validate --config tau/smoke.yaml
  tau run validate --config tau/train.yaml
{{if .HasWorkspaceConnection}}  tau run smoke
  tau run --config tau/smoke.yaml
  tau run train
{{else}}  # Ask the platform owner to add tau/workspace.connection.yaml before cluster runs.
{{end}}
EOF
