apiVersion: ray.io/v1
kind: RayJob
metadata:
  name: ${RESOURCE_NAME}
  namespace: ${NAMESPACE}
  labels:
    kueue.x-k8s.io/queue-name: ${QUEUE_NAME}
${JOB_LABELS}${JOB_ANNOTATIONS_BLOCK}
spec:
  suspend: true
  shutdownAfterJobFinishes: true
  ttlSecondsAfterFinished: 15
  submissionMode: HTTPMode
  entrypoint: |
    set -eu
${DRIVER_LOG_COMPLETION_SETUP}
{{if .MetricsOffload.Enabled}}    TAU_METRICS_COMPLETION={{.MetricsOffload.CompletionFileShell}}
    TAU_METRICS_DONE={{.MetricsOffload.DoneFileShell}}
    TAU_METRICS_DONE_TIMEOUT={{.MetricsOffload.DoneTimeoutSeconds}}
    tau_write_metrics_completion() {
      status="$?"
      trap - EXIT
      state="succeeded"
      if [ "$status" -ne 0 ]; then
        state="failed"
      fi
      completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      (mkdir -p "$(dirname "$TAU_METRICS_COMPLETION")" && printf '{"state":"%s","reason":"rayjob-entrypoint-exit","message":"entrypoint exited with code %s","completed_at":"%s"}\n' "$state" "$status" "$completed_at" > "$TAU_METRICS_COMPLETION") || true
      deadline=$(( $(date +%s) + TAU_METRICS_DONE_TIMEOUT ))
      while [ ! -f "$TAU_METRICS_DONE" ]; do
        if [ "$(date +%s)" -ge "$deadline" ]; then
          echo "metrics offloader did not confirm terminal publication within ${TAU_METRICS_DONE_TIMEOUT}s" >&2
          if [ "$status" -eq 0 ]; then
            status=125
          fi
          break
        fi
        sleep 1
      done
      tau_write_driver_log_completion "$status"
      exit "$status"
    }
    trap tau_write_metrics_completion EXIT
{{else}}    trap tau_complete_driver_logs EXIT
{{end}}
${STORAGE_PREFLIGHT}
    pip install --quiet --no-cache-dir ${PIP_PACKAGES} \
      || pip install --quiet --no-cache-dir --user ${PIP_PACKAGES}
    PATH="$(python3 -m site --user-base)/bin:$PATH"
    export PATH
    python3 /script/train.py \
      --manifest /manifest/${MANIFEST_NAME} \
      --smoke-pairs ${SMOKE_PAIRS}
  runtimeEnvYAML: |
    pip:
{{- range .RuntimePip }}
      - {{ . }}
{{- end }}
  rayClusterSpec:
    rayVersion: "2.54.0"
    headGroupSpec:
      rayStartParams:
        dashboard-host: "0.0.0.0"
        num-cpus: "0"
        num-gpus: "0"
      template:
${POD_METADATA_BLOCK}
        spec:
          restartPolicy: Never
{{if .MetricsOffload.Enabled}}          terminationGracePeriodSeconds: {{.MetricsOffload.ShutdownGraceSeconds}}
{{end}}
${NODE_SELECTOR_BLOCK}
${POD_PRIORITY_CLASS_BLOCK}${SERVICE_ACCOUNT_BLOCK}
          tolerations:
            - { effect: NoSchedule, key: CriticalAddonsOnly, operator: Exists }
${PAYLOAD_INIT_CONTAINERS_HEAD}          containers:
            - name: ray-head
              image: ${IMAGE}
              env:
                - { name: HF_HOME, value: "/tmp/hf" }
                - { name: GIT_PYTHON_REFRESH, value: "quiet" }
                - { name: TAU_DATA_DIR, value: "/data" }
                - { name: TAU_HOT_DIR, value: "/mnt" }
                - { name: TAU_DATASETS_DIR, value: "/mnt/datasets" }
                - { name: TAU_CHECKPOINTS_DIR, value: "/mnt/checkpoints" }
                - { name: TAU_DURABLE_DATASETS_DIR, value: "/data/datasets" }
                - { name: TAU_DURABLE_CHECKPOINTS_DIR, value: "/data/checkpoints" }
                - { name: TAU_METRICS_HISTORY, value: "/data/checkpoints/finetunes/${NAME}/metrics-history.jsonl" }
                - { name: TAU_UPSTREAM_CHECKPOINT, value: "${UPSTREAM_CHECKPOINT}" }
${RUNTIME_ENV_HEAD}
              resources:
                requests: { cpu: "${CONTROL_CPUS}", memory: "${CONTROL_MEMORY}" }
                limits:   { cpu: "${CONTROL_CPU_LIMIT}", memory: "${CONTROL_MEMORY_LIMIT}" }
              volumeMounts:
                - { name: script,   mountPath: /script,   readOnly: true }
                - { name: manifest, mountPath: /manifest, readOnly: true }
                - { name: data,     mountPath: /data }
                - { name: tau-hot, mountPath: /mnt }
                - { name: dshm,     mountPath: /dev/shm }
${EXTRA_VOLUME_MOUNTS_HEAD}
              readinessProbe:
                exec:
                  command: ["python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 8265), 2).close()"]
                initialDelaySeconds: 10
                periodSeconds: 10
              livenessProbe:
                exec:
                  command: ["python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 8265), 2).close()"]
                initialDelaySeconds: 30
                periodSeconds: 20
{{if .MetricsOffload.Enabled}}            - name: metrics-offload
              image: {{.MetricsOffload.ImageYAML}}
              imagePullPolicy: IfNotPresent
              env:
                - name: NODE_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
{{if .MetricsOffload.CollectorV1}}                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
{{end}}
                - { name: TAU_EXP_STORE, value: {{.MetricsOffload.StoreYAML}} }
                - { name: TAU_METRICS_HISTORY, value: {{.MetricsOffload.HistoryYAML}} }
                - { name: TAU_METRICS_OFFLOAD_RUN, value: "${NAME}" }
                - { name: TAU_METRICS_OFFLOAD_PROJECT, value: {{.MetricsOffload.ProjectYAML}} }
                - { name: TAU_METRICS_OFFLOAD_EXPERIMENT, value: {{.MetricsOffload.ExperimentYAML}} }
                - { name: TAU_METRICS_OFFLOAD_GROUP, value: {{.MetricsOffload.GroupYAML}} }
                - { name: TAU_METRICS_OFFLOAD_TAGS, value: {{.MetricsOffload.TagsYAML}} }
                - { name: TAU_METRICS_OFFLOAD_SOURCE, value: {{.MetricsOffload.SourceYAML}} }
                - { name: TAU_METRICS_OFFLOAD_OUT, value: {{.MetricsOffload.OutYAML}} }
                - { name: TAU_METRICS_OFFLOAD_COMPLETION_FILE, value: {{.MetricsOffload.CompletionFileYAML}} }
                - { name: TAU_METRICS_OFFLOAD_INTERVAL, value: {{.MetricsOffload.IntervalYAML}} }
{{if .MetricsOffload.CollectorV1}}                - { name: TAU_METRICS_OFFLOAD_DELIVERY_MODE, value: {{.MetricsOffload.DeliveryModeYAML}} }
                - { name: TAU_METRICS_OFFLOAD_ADX_CLUSTER_URI, value: {{.MetricsOffload.ADXClusterURIYAML}} }
                - { name: TAU_METRICS_OFFLOAD_ADX_DATABASE, value: {{.MetricsOffload.ADXDatabaseYAML}} }
                - { name: TAU_METRICS_OFFLOAD_ADX_TABLE, value: {{.MetricsOffload.ADXTableYAML}} }
                - { name: TAU_METRICS_OFFLOAD_ADX_MAPPING, value: {{.MetricsOffload.ADXMappingYAML}} }
                - { name: TAU_METRICS_OFFLOAD_ADX_CLIENT_ID, value: {{.MetricsOffload.ADXClientIDYAML}} }
                - { name: TAU_METRICS_OFFLOAD_ADX_MAX_ATTEMPTS, value: {{.MetricsOffload.ADXMaxAttemptsYAML}} }
                - { name: TAU_METRICS_OFFLOAD_ADX_RETRY_BACKOFF, value: {{.MetricsOffload.ADXRetryBackoffYAML}} }
                - { name: TAU_METRICS_OFFLOAD_ADX_FINAL_STATUS_TIMEOUT, value: {{.MetricsOffload.ADXFinalStatusTimeoutYAML}} }
{{end}}
                - { name: TAU_GROUP, value: {{.MetricsOffload.GroupYAML}} }
                - { name: TAU_EXPERIMENT, value: {{.MetricsOffload.ExperimentYAML}} }
              command: [{{.MetricsOffload.CommandYAML}}]
              args: [{{.MetricsOffload.ArgsPrefixYAML}}, "--done-file", {{.MetricsOffload.DoneFileYAML}}]
              resources:
                requests: { cpu: "100m", memory: "128Mi" }
                limits:   { cpu: "500m", memory: "512Mi" }
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
              volumeMounts:
                - { name: data, mountPath: /data }
{{end}}
${DRIVER_LOG_OFFLOAD_SIDECAR}
          volumes:
            - name: script
              emptyDir: {}
            - name: manifest
              emptyDir: {}
            - name: data{{if .DataPVC}}
              persistentVolumeClaim: { claimName: ${DATA_PVC} }{{else}}
              emptyDir: {}{{end}}
            - name: tau-hot
              emptyDir: {}
            - name: dshm
              emptyDir: { medium: Memory, sizeLimit: 4Gi }
${EXTRA_VOLUMES_HEAD}
    workerGroupSpecs:
      - replicas: 1
        minReplicas: 1
        maxReplicas: 1
        groupName: ${RESOURCE_NAME}-gpu
        rayStartParams:
          num-gpus: "${GPUS}"
        template:
${WORKER_POD_METADATA_BLOCK}
          spec:
            restartPolicy: Never
${WORKER_NODE_SELECTOR_BLOCK}${WORKER_POD_PRIORITY_CLASS_BLOCK}${WORKER_SERVICE_ACCOUNT_BLOCK}
            tolerations:
              - { effect: NoSchedule, key: sku, operator: Equal, value: gpu }
              - { effect: NoSchedule, key: nvidia.com/gpu, operator: Exists }
${PAYLOAD_INIT_CONTAINERS_WORKER}            containers:
              - name: ray-gpu-worker
                image: ${IMAGE}
                env:
                  - { name: HF_HOME, value: "/tmp/hf" }
                  - { name: GIT_PYTHON_REFRESH, value: "quiet" }
                  - { name: TAU_DATA_DIR, value: "/data" }
                  - { name: TAU_HOT_DIR, value: "/mnt" }
                  - { name: TAU_DATASETS_DIR, value: "/mnt/datasets" }
                  - { name: TAU_CHECKPOINTS_DIR, value: "/mnt/checkpoints" }
                  - { name: TAU_DURABLE_DATASETS_DIR, value: "/data/datasets" }
                  - { name: TAU_DURABLE_CHECKPOINTS_DIR, value: "/data/checkpoints" }
                  - { name: TAU_METRICS_HISTORY, value: "/data/checkpoints/finetunes/${NAME}/metrics-history.jsonl" }
                  - { name: TAU_UPSTREAM_CHECKPOINT, value: "${UPSTREAM_CHECKPOINT}" }
${RUNTIME_ENV_WORKER}
{{if .RDMAEnabled}}                securityContext:
                  runAsUser: 0
                  runAsGroup: 0
                  allowPrivilegeEscalation: false
                  seccompProfile:
                    type: RuntimeDefault
                  capabilities:
                    drop:
                      - ALL
                    add:
                      - IPC_LOCK
                      - SYS_RESOURCE
                      - DAC_OVERRIDE
{{end}}
                resources:{{if .UseDRA}}
                  claims:
                    - name: gpu
                  requests: { cpu: "${CPUS}", memory: "${MEMORY}" }
                  limits:   { cpu: "${CPU_LIMIT}", memory: "${MEMORY_LIMIT}" }{{else if .UseDevicePlugin}}
                  requests: { cpu: "${CPUS}", memory: "${MEMORY}", {{.GPUResourceName}}: "{{.GPUs}}" }
                  limits:   { cpu: "${CPU_LIMIT}", memory: "${MEMORY_LIMIT}", {{.GPUResourceName}}: "{{.GPUs}}" }{{else}}
                  requests: { cpu: "${CPUS}", memory: "${MEMORY}" }
                  limits:   { cpu: "${CPU_LIMIT}", memory: "${MEMORY_LIMIT}" }{{end}}
                volumeMounts:
                  - { name: script, mountPath: /script, readOnly: true }
                  - { name: data, mountPath: /data }
                  - { name: tau-hot, mountPath: /mnt }
${EXTRA_VOLUME_MOUNTS_WORKER}
                readinessProbe:
                  exec:
                    command: ["python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 52365), 2).close()"]
                  initialDelaySeconds: 10
                  periodSeconds: 10
                livenessProbe:
                  exec:
                    command: ["python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 52365), 2).close()"]
                  initialDelaySeconds: 30
                  periodSeconds: 20
{{if .UseDRA}}            resourceClaims:
              - name: gpu
                resourceClaimTemplateName: ${CLAIM}
{{end}}
            volumes:
              - name: script
                emptyDir: {}
              - name: data{{if .DataPVC}}
                persistentVolumeClaim: { claimName: ${DATA_PVC} }{{else}}
                emptyDir: {}{{end}}
              - name: tau-hot
                emptyDir: {}
${EXTRA_VOLUMES_WORKER}
      - replicas: ${CPU_WORKERS}
        minReplicas: ${CPU_WORKERS}
        maxReplicas: ${CPU_WORKERS}
        groupName: ${RESOURCE_NAME}-cpu
        rayStartParams:
          num-cpus: "${WORKER_CPUS}"
          num-gpus: "0"
        template:
${CPU_WORKER_POD_METADATA_BLOCK}
          spec:
            restartPolicy: Never
${CPU_WORKER_NODE_SELECTOR_BLOCK}${CPU_WORKER_POD_PRIORITY_CLASS_BLOCK}${CPU_WORKER_SERVICE_ACCOUNT_BLOCK}
${PAYLOAD_INIT_CONTAINERS_WORKER}            containers:
              - name: ray-worker
                image: ${IMAGE}
                env:
                  - { name: HF_HOME, value: "/tmp/hf" }
                  - { name: GIT_PYTHON_REFRESH, value: "quiet" }
                  - { name: TAU_DATA_DIR, value: "/data" }
                  - { name: TAU_HOT_DIR, value: "/mnt" }
                  - { name: TAU_DATASETS_DIR, value: "/mnt/datasets" }
                  - { name: TAU_CHECKPOINTS_DIR, value: "/mnt/checkpoints" }
                  - { name: TAU_DURABLE_DATASETS_DIR, value: "/data/datasets" }
                  - { name: TAU_DURABLE_CHECKPOINTS_DIR, value: "/data/checkpoints" }
                  - { name: TAU_METRICS_HISTORY, value: "/data/checkpoints/finetunes/${NAME}/metrics-history.jsonl" }
                  - { name: TAU_UPSTREAM_CHECKPOINT, value: "${UPSTREAM_CHECKPOINT}" }
${RUNTIME_ENV_WORKER}
                resources:
                  requests: { cpu: "${WORKER_CPUS}", memory: "${WORKER_MEMORY}" }
                  limits:   { cpu: "${WORKER_CPU_LIMIT}", memory: "${WORKER_MEMORY_LIMIT}" }
                volumeMounts:
                  - { name: script,   mountPath: /script,   readOnly: true }
                  - { name: data,     mountPath: /data }
                  - { name: tau-hot, mountPath: /mnt }
${EXTRA_VOLUME_MOUNTS_WORKER}
                readinessProbe:
                  exec:
                    command: ["python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 52365), 2).close()"]
                  initialDelaySeconds: 10
                  periodSeconds: 10
                livenessProbe:
                  exec:
                    command: ["python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 52365), 2).close()"]
                  initialDelaySeconds: 30
                  periodSeconds: 20
            volumes:
              - name: script
                emptyDir: {}
              - name: data{{if .DataPVC}}
                persistentVolumeClaim: { claimName: ${DATA_PVC} }{{else}}
                emptyDir: {}{{end}}
              - name: tau-hot
                emptyDir: {}
${EXTRA_VOLUMES_WORKER}
