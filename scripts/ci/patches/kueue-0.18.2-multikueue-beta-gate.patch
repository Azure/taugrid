diff --git a/templates/_helpers.tpl b/templates/_helpers.tpl
index 8d6aa37..8252803 100644
--- a/templates/_helpers.tpl
+++ b/templates/_helpers.tpl
@@ -110,6 +110,31 @@ app.kubernetes.io/component: controller
 {{- end }}
 
 {{/*
+TauGrid distribution gate for every MultiKueue activation surface.
+*/}}
+{{- define "kueue.multiKueueBetaEnabled" -}}
+{{- $global := .Values.global | default dict -}}
+{{- $featureEnabled := has "multikueue" (get $global "betaFeatures" | default list) -}}
+{{- $riskAcknowledged := has "multikueue" (get $global "betaRiskAcknowledgements" | default list) -}}
+{{- if ne $featureEnabled $riskAcknowledged -}}
+{{- fail "MultiKueue Beta requires both global.betaFeatures=[multikueue] and global.betaRiskAcknowledgements=[multikueue]; enabling only one is not permitted" -}}
+{{- end -}}
+{{- $activationRequested := false -}}
+{{- range (.Values.controllerManager.featureGates | default (list)) -}}
+  {{- if and (eq (lower (.name | default "")) "multikueue") (.enabled | default false) -}}
+    {{- $activationRequested = true -}}
+  {{- end -}}
+{{- end -}}
+{{- if and (not (kindIs "invalid" .Values.aksExtension.enableMultiKueue)) (.Values.aksExtension.enableMultiKueue | default false) -}}
+  {{- $activationRequested = true -}}
+{{- end -}}
+{{- if and $activationRequested (not (and $featureEnabled $riskAcknowledged)) -}}
+{{- fail "MultiKueue configuration was supplied without the required Beta gate; set both global.betaFeatures=[multikueue] and global.betaRiskAcknowledgements=[multikueue]" -}}
+{{- end -}}
+{{- if and $activationRequested $featureEnabled $riskAcknowledged -}}true{{- end -}}
+{{- end -}}
+
+{{/*
 FeatureGates — patched by aks-ai-runtime.
 Upstream logic is preserved verbatim; AKS-only additions manage MultiKueue
 before rendering. Priority rules:
@@ -123,6 +148,7 @@ Any upstream change to the rendering loop is picked up automatically because
 we mutate the source list, not the output string.
 */}}
 {{- define "kueue.featureGates" -}}
+{{- $_ := include "kueue.multiKueueBetaEnabled" . -}}
 {{- $multiKueueFromBase := "" -}}
 {{- range (.Values.controllerManager.featureGates | default (list)) -}}
   {{- if eq .name "MultiKueue" -}}{{- $multiKueueFromBase = .enabled | toString -}}{{- end -}}
