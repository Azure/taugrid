{
  "type": "excalidraw",
  "version": 2,
  "source": "github-copilot",
  "elements": [
    {"type":"text","id":"title","x":40,"y":20,"width":1100,"height":75,"text":"How a researcher interacts with a Tau-enabled AKS cluster","fontSize":30,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"text","id":"subtitle","x":40,"y":65,"width":1450,"height":38,"text":"Repository → Tau → Kueue/KubeRay → GPU work → durable evidence → next iteration","fontSize":15,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"boundary","x":40,"y":100,"width":1520,"height":58,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"boundary_text","x":65,"y":111,"width":1460,"height":55,"text":"DAY 2 RESEARCHER BOUNDARY — No Azure provisioning, cluster-admin credentials, namespace/queue creation, or hand-authored Kubernetes YAML.","fontSize":15,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},

    {"type":"rectangle","id":"lane_researcher","x":40,"y":185,"width":1520,"height":260,"strokeColor":"#0078D4","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"lane_researcher_title","x":62,"y":198,"width":450,"height":43,"text":"1 · Researcher workstation","fontSize":17,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"repo","x":70,"y":260,"width":255,"height":145,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"repo_text","x":88,"y":273,"width":220,"height":125,"text":"1 · PLATFORM HANDOFF\nOpen the project repo\n\n• Entra group membership\n• workspace.connection.yaml\n• source + tau/train.yaml","fontSize":13,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"author","x":370,"y":260,"width":255,"height":145,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"author_text","x":388,"y":273,"width":220,"height":125,"text":"2 · AUTHOR + CHECK\nEdit code and run intent\n\ntau workspace connection inspect\ntau run train --dry-run=client","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"submit","x":670,"y":260,"width":255,"height":145,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"submit_text","x":688,"y":273,"width":220,"height":125,"text":"3 · SUBMIT\nUse the small Tau surface\n\ntau run smoke\ntau run train\n\nNo workspace/context/queue flags","fontSize":13,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"observe","x":970,"y":260,"width":255,"height":145,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"observe_text","x":988,"y":273,"width":220,"height":125,"text":"4 · OBSERVE + CONTROL\nFollow real progress\n\ntau run status NAME --watch\ntau run logs NAME\ntau run list | cancel NAME","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"iterate","x":1270,"y":260,"width":255,"height":145,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"iterate_text","x":1288,"y":273,"width":220,"height":125,"text":"5 · RETRIEVE + ITERATE\nUse durable evidence\n\ntau run get NAME\nCompare in Stellar\nUpdate code/config and run again","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},

    {"type":"rectangle","id":"lane_control","x":40,"y":475,"width":1520,"height":220,"strokeColor":"#F7630C","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"lane_control_title","x":62,"y":488,"width":600,"height":43,"text":"2 · Tau and cluster control plane","fontSize":17,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"workspace","x":70,"y":548,"width":255,"height":112,"strokeColor":"#495057","backgroundColor":"#F3F2F1","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"workspace_text","x":88,"y":561,"width":220,"height":95,"text":"PRE-EXISTING PLATFORM\nTauWorkspace is Ready\n\nNamespace · LocalQueue · PVC\nServiceAccount/RBAC · defaults","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"resolve","x":370,"y":548,"width":255,"height":112,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"resolve_text","x":388,"y":561,"width":220,"height":95,"text":"RESOLVE\nDiscover connection + defaults\n\nFirst-use cluster-user credentials\nVerify workspace, queue, authorization","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"render","x":670,"y":548,"width":255,"height":112,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"render_text","x":688,"y":561,"width":220,"height":95,"text":"RENDER + APPLY\nJob or KubeRay RayJob\n\nQueue labels · GPU resources\n/data mounts · workload identity","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"admit","x":970,"y":548,"width":255,"height":112,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"admit_text","x":988,"y":561,"width":220,"height":95,"text":"ADMIT + ORCHESTRATE\nKueue → KubeRay\n\nWait for quota/capacity\nCreate Ray cluster after admission","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"status_api","x":1270,"y":548,"width":255,"height":112,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"status_api_text","x":1288,"y":561,"width":220,"height":95,"text":"STATUS SURFACE\nTau reads cluster state\n\nAdmission · scheduling · pods\nEvents · logs · terminal state","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},

    {"type":"rectangle","id":"lane_exec","x":40,"y":725,"width":1520,"height":215,"strokeColor":"#107C10","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"lane_exec_title","x":62,"y":738,"width":850,"height":43,"text":"3 · Workload execution, data, and experiment evidence","fontSize":17,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"pods","x":370,"y":800,"width":255,"height":105,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"pods_text","x":388,"y":813,"width":220,"height":85,"text":"WORKSPACE NAMESPACE\nHead, worker, or Job pods\n\nServiceAccount · secrets · /data","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"gpu","x":670,"y":800,"width":255,"height":105,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"gpu_text","x":688,"y":813,"width":220,"height":85,"text":"REAL EXECUTION\nModel + data make progress\n\nGPU allocation · CUDA · checkpoints","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"outputs","x":970,"y":800,"width":255,"height":105,"strokeColor":"#0C8599","backgroundColor":"#D8F3F5","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"outputs_text","x":988,"y":813,"width":220,"height":85,"text":"DURABLE OUTPUTS\nShared /data storage\n\nCheckpoints · models · result files","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"rectangle","id":"stellar","x":1270,"y":800,"width":255,"height":105,"strokeColor":"#0C8599","backgroundColor":"#D8F3F5","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"stellar_text","x":1288,"y":813,"width":220,"height":85,"text":"EXPERIMENT VIEW\nStellar + metrics\n\nCompare runs, curves, labels, artifacts","fontSize":12,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},

