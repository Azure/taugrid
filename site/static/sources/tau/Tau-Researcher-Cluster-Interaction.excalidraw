    {"type":"rectangle","id":"caveat","x":40,"y":956,"width":1520,"height":28,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":1,"roundness":{"type":3}},
    {"type":"text","id":"caveat_text","x":60,"y":960,"width":1480,"height":30,"text":"Current test descriptors may use cluster-wide authorization: workspace routing/defaults are not researcher isolation. Managed Entra workspace-RBAC remains the target.","fontSize":11,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"}
