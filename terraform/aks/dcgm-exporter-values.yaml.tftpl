image:
  repository: mcr.microsoft.com/oss/v2/nvidia/dcgm-exporter
  digest: sha256:1c9ecef62702a358e66e9d76a80bc2653ed2013e1356044c5c20a98c269df1af

nodeSelector:
  kubernetes.azure.com/agentpool: ${gpu_node_pool_name}

tolerations:
  - key: sku
    operator: Equal
    value: gpu
    effect: NoSchedule

podAnnotations:
  adx-mon/scrape: "true"

kubernetes:
  # Keep one DCGM series per physical GPU. The Portal fleet board keys a GPU
  # by node and device, while DCGM Pod labels would create an additional row
  # for every workload using that device.
  enablePodLabels: false
