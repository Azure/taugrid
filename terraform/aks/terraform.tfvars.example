# Copy this file to terraform.tfvars and replace all placeholder values.
# terraform.tfvars is intentionally ignored and must not be committed.

subscription_id     = "<azure-subscription-id>"
location            = "swedencentral"
resource_group_name = "<resource-group-name>"
cluster_name        = "<cluster-name>"

# Managed Entra and local accounts are enabled by default.
# Optionally grant an Entra group cluster-admin access.
# Keep Azure RBAC disabled for TauWorkspace RBAC.
# aks_admin_group_object_ids = ["<entra-admin-group-object-id>"]
# azure_rbac_enabled          = false

# Use this interpreter on Linux, WSL, and macOS.
command_interpreter = ["bash", "-c"]

# The defaults below create one billable A100 GPU node.
gpu_vm_size             = "Standard_NC24ads_A100_v4"
gpu_node_count          = 1
gpu_count_per_node      = 1
gpu_monitoring_sku_name = "a100-pcie-1g"
gpu_flavor_name         = "taugrid-a100"
gpu_class               = "a100-80gb"
gpu_series              = "nc24ads-a100-v4"

# The default self_managed mode installs the NVIDIA device plugin and upstream
# NVIDIA DCGM exporter. aks_managed_preview uses AKS Managed GPU Experience.
gpu_stack_mode = "self_managed"

# The default A100 GPU pool is normalized from MIG mode before TauGrid installs.
normalize_gpu_mig = true

# Set these instead of gpu_node_count to scale the GPU pool automatically.
gpu_auto_scaling_enabled = false
gpu_min_count            = 1
gpu_max_count            = 1

# ADX enables adx-mon, DCGM GPU telemetry, and Portal Kusto data.
enable_adx = true
# Empty generates a stable name shaped like taugrid1a2b3c4d. Set an explicit
# globally unique 4-22 character lowercase alphanumeric name only when needed.
adx_cluster_name = ""

# Terraform bootstraps this target namespace before the TauGrid install so ADX,
# lifecycle recording, and Portal run history can be enabled in one apply.
# After apply, create the TauWorkspace against this same namespace.
enable_lifecycle_recorder = true
workspace_namespace       = "taugrid-default"
