{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "tauCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managementMode",
        "deletionPolicy",
        "queues"
      ],
      "properties": {
        "managementMode": {
          "type": "string",
          "enum": [
            "Observe",
            "Reconcile"
          ]
        },
        "deletionPolicy": {
          "type": "string",
          "enum": [
            "Retain",
            "DeleteManaged"
          ]
        },
        "nodeLabelRules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/nodeLabelRule"
          }
        },
        "extraNodeLabelRules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nodeLabelRule"
          }
        },
        "queues": {
          "$ref": "#/definitions/ownership"
        }
      }
    },
    "platformNamespace": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "partOf": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object"
    }
  },
  "required": [
    "platformNamespace",
    "partOf",
    "image",
    "tauCluster"
  ],
  "definitions": {
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership"
      ],
      "properties": {
        "ownership": {
          "type": "string",
          "enum": [
            "External",
            "Adopt",
            "Manage"
          ]
        }
      }
    },
    "nodeLabelRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "labels"
      ],
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vmSizes"
          ],
          "properties": {
            "vmSizes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
