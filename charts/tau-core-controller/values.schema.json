{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true
    },
    "tauCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managementMode",
        "deletionPolicy",
        "queues",
        "workloadProfiles"
      ],
      "properties": {
        "managementMode": {
          "type": "string",
          "enum": [
            "Observe",
            "Reconcile"
          ]
        },
        "deletionPolicy": {
          "type": "string",
          "enum": [
            "Retain",
            "DeleteManaged"
          ]
        },
        "nodeLabelRules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/nodeLabelRule"
          }
        },
        "extraNodeLabelRules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nodeLabelRule"
          }
        },
        "queues": {
          "$ref": "#/definitions/ownership"
        },
        "defaultWorkloadProfileNamespace": {
          "type": "string",
          "minLength": 1
        },
        "workloadProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/workloadProfile"
          }
        }
      }
    },
    "partOf": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object"
    }
  },
  "required": [
    "partOf",
    "image",
    "tauCluster"
  ],
  "definitions": {
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership"
      ],
      "properties": {
        "ownership": {
          "type": "string",
          "enum": [
            "External",
            "Adopt",
            "Manage"
          ]
        }
      }
    },
    "nodeLabelRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "labels"
      ],
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vmSizes"
          ],
          "properties": {
            "vmSizes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "labels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "workloadProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "gpusPerWorker",
          "workerCount",
          "mode",
          "placement",
          "defaultLocalQueue",
          "executionTarget",
          "priorities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "description": {
            "type": "string"
          },
          "applicability": {
            "$ref": "#/definitions/profileApplicability"
          },
          "gpusPerWorker": {
            "type": "integer",
            "minimum": 0
          },
          "workerCount": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixed",
              "elastic"
            ]
          },
          "placement": {
            "type": "string",
            "enum": [
              "independent",
              "single-node-nvlink",
              "multi-node-nccl"
            ]
          },
          "defaultLocalQueue": {
            "type": "string",
            "minLength": 1
          },
          "executionTarget": {
            "type": "string",
            "enum": [
              "singleCluster",
              "multiKueue"
            ]
          },
          "priorities": {
            "$ref": "#/definitions/profilePriorities"
          }
        }
      },
    "profileApplicability": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "teams": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lanes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
    "profilePriorities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workloadPriorityClassName": {
          "type": "string"
        },
        "podPriorityClassName": {
          "type": "string"
        },
        "disableDefaultPriorities": {
          "type": "boolean"
        }
      }
    }
  }
}
