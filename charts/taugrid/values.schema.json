{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "taugrid-core": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "portal": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "entraAuth": {
              "description": "Opt-in Portal Entra authentication; the taugrid-core dependency validates the complete configuration.",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "adx": {
          "type": "object",
          "properties": {
            "queryConnection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "endpoint": { "type": "string" },
                "database": { "type": "string" },
                "clientID": { "type": "string" }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "baselineQueue": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "nominalQuota"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "nominalQuota": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ]
              }
            }
          }
        },
        "gpu": {
          "type": "object",
          "required": [
            "coveredResources",
            "flavors"
          ],
          "properties": {
            "coveredResources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "flavors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "resources"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "nominalQuota"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "nominalQuota": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "enabled",
        "name",
        "gpu",
        "resources"
      ]
    }
  }
}
