{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "betaFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "multikueue"
            ]
          }
        },
        "betaRiskAcknowledgements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "multikueue"
            ]
          }
        }
      },
      "required": [
        "betaFeatures",
        "betaRiskAcknowledgements"
      ]
    },
    "baselineQueue": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "topology": {
          "type": "object",
          "required": [
            "enabled",
            "name"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "requiredLevel": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "flavor": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "nodeLabels": {
              "type": "object"
            },
            "tolerations": {
              "type": "array"
            }
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "nominalQuota"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "nominalQuota": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ]
              }
            }
          }
        },
        "gpu": {
          "type": "object",
          "required": [
            "enabled",
            "coveredResources",
            "flavors"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "coveredResources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "flavors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "nodeTaints",
                  "resources"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nodeLabels": {
                    "type": "object"
                  },
                  "nodeTaints": {
                    "type": "array",
                    "minItems": 1
                  },
                  "tolerations": {
                    "type": "array"
                  },
                  "resources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "nominalQuota"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "nominalQuota": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "number",
                              "minimum": 0
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "enabled",
        "name",
        "topology",
        "flavor",
        "gpu",
        "resources"
      ]
    }
  },
  "required": [
    "global"
  ]
}
